#!/bin/bash
set -Eeuo pipefail
umask 077

REGION='${aws_region}'
TOKEN_PARAMETER='${registration_token_parameter}'
REPOSITORY_URL='${repository_url}'
RUNNER_DIR='/opt/actions-runner'
RUNNER_USER='actions-runner'

for attempt in $(seq 1 30); do
  if aws ssm get-parameter --region "$REGION" --name "$TOKEN_PARAMETER" \
      --with-decryption --query 'Parameter.Value' --output text \
      > /run/project-3-runner-token 2>/dev/null; then
    break
  fi
  sleep 10
done

if [[ ! -s /run/project-3-runner-token ]]; then
  echo "No fresh runner registration token found in SSM." >&2
  exit 1
fi

chmod 0600 /run/project-3-runner-token
runner_token="$(cat /run/project-3-runner-token)"
rm -f /run/project-3-runner-token

runuser -u "$RUNNER_USER" -- "$RUNNER_DIR/config.sh" \
  --unattended --url "$REPOSITORY_URL" --token "$runner_token" \
  --name "project-3-scanner-$(hostname)" --labels "project-3-scanner" \
  --work _work --disableupdate
unset runner_token

aws ssm delete-parameter --region "$REGION" --name "$TOKEN_PARAMETER"

cat > /etc/systemd/system/actions.runner.project-3-scanner.service <<'UNIT'
[Unit]
Description=Project 3 GitHub Actions scanner runner
After=network-online.target
Wants=network-online.target

[Service]
User=actions-runner
Group=actions-runner
WorkingDirectory=/opt/actions-runner
ExecStart=/opt/actions-runner/run.sh
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now actions.runner.project-3-scanner.service
