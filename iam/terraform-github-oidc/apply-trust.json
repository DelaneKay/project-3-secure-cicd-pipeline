{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsApplyFromProtectedEnvironment",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::273517699789:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:DelaneKay@59389630/project-3-secure-cicd-pipeline@1438456744:environment:terraform-lab-apply"
        }
      }
    }
  ]
}
