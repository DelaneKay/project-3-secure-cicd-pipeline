{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchProjectAmis",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1::image/ami-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:Owner": "273517699789"
        }
      }
    },
    {
      "Sid": "LaunchApprovedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "ec2:InstanceType": [
            "t3.small",
            "c7i-flex.large"
          ]
        }
      }
    },
    {
      "Sid": "LaunchInTaggedSubnets",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline",
          "ec2:Vpc": "arn:aws:ec2:us-east-1:273517699789:vpc/vpc-0ea64498832a70076"
        }
      }
    },
    {
      "Sid": "UseTaggedLabSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline",
          "ec2:Vpc": "arn:aws:ec2:us-east-1:273517699789:vpc/vpc-0ea64498832a70076"
        }
      }
    },
    {
      "Sid": "LaunchInterfacesInLabVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:Vpc": "arn:aws:ec2:us-east-1:273517699789:vpc/vpc-0ea64498832a70076",
          "ec2:Subnet": [
            "arn:aws:ec2:us-east-1:273517699789:subnet/subnet-05343cbef4a0e3cc2",
            "arn:aws:ec2:us-east-1:273517699789:subnet/subnet-06ac38ae6a72b8bff",
            "arn:aws:ec2:us-east-1:273517699789:subnet/subnet-07aa04ba2ad854a44",
            "arn:aws:ec2:us-east-1:273517699789:subnet/subnet-0bfefa6b0f02e17b6"
          ]
        }
      }
    },
    {
      "Sid": "LaunchEncryptedVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::project-3-tfstate-273517699789-us-east-1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::project-3-tfstate-273517699789-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "project-3/*"
          ]
        }
      }
    },
    {
      "Sid": "StateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::project-3-tfstate-273517699789-us-east-1/project-3/*/terraform.tfstate"
    },
    {
      "Sid": "StateLocks",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::project-3-tfstate-273517699789-us-east-1/project-3/*/terraform.tfstate.tflock"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteVpc",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSubnet",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:ModifyVpcEndpoint",
        "ec2:DeleteVpcEndpoints",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup",
        "ec2:TerminateInstances",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline"
        }
      }
    },
    {
      "Sid": "ManageIAM",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "arn:aws:iam::273517699789:role/project-3-secure-cicd-pipeline-*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::273517699789:role/project-3-secure-cicd-pipeline-*",
        "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::273517699789:instance-profile/project-3-secure-cicd-pipeline-*",
        "arn:aws:iam::273517699789:role/project-3-secure-cicd-pipeline-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::273517699789:role/project-3-secure-cicd-pipeline-*"
    },
    {
      "Sid": "PassRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::273517699789:role/project-3-secure-cicd-pipeline-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "secretsmanager:Name": "rds!*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:273517699789:secret:rds!*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:273517699789:key/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/aws/secretsmanager"
        }
      }
    },
    {
      "Sid": "SonarDB",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "rds:CreateDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:DeleteDBSubnetGroup"
      ],
      "Resource": [
        "arn:aws:rds:us-east-1:273517699789:db:project-3-sonarqube",
        "arn:aws:rds:us-east-1:273517699789:subgrp:project-3-sonarqube-subnets"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "rds.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:us-east-1:273517699789:log-group:/project-3/*"
    },
    {
      "Sid": "ScanTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:GetSubscriptionAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:ListTagsForResource"
      ],
      "Resource": "arn:aws:sns:us-east-1:273517699789:project-3-secure-cicd-pipeline-scan-findings"
    },
    {
      "Sid": "RunnerToken",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:us-east-1:273517699789:parameter/project-3/github-runner/registration-token"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateInternetGateway"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:273517699789:vpc/*",
        "arn:aws:ec2:us-east-1:273517699789:subnet/*",
        "arn:aws:ec2:us-east-1:273517699789:internet-gateway/*",
        "arn:aws:ec2:us-east-1:273517699789:route-table/*",
        "arn:aws:ec2:us-east-1:273517699789:security-group/*",
        "arn:aws:ec2:us-east-1:273517699789:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:vpc/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:vpc/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:vpc/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:273517699789:route-table/*",
        "arn:aws:ec2:us-east-1:273517699789:security-group/*",
        "arn:aws:ec2:us-east-1:273517699789:subnet/*",
        "arn:aws:ec2:us-east-1:273517699789:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TagProjectInstancesWhenLaunched",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:ec2:us-east-1:273517699789:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "project-3-secure-cicd-pipeline",
          "aws:RequestedRegion": "us-east-1",
          "ec2:CreateAction": "RunInstances"
        }
      }
    }
  ]
}
